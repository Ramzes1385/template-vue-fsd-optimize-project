{
  "name": "tm2",
  "version": "1.0.0",
  "private": "true",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint .",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write src/",
    "prepare": "husky",
    "typecheck": "vue-tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "analyze": "npm run build",
    "lighthouse": "npx lighthouse http://127.0.0.1:4173 --output=html --output-path=reports/lighthouse/report.html --view",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "release": "semantic-release --extends ./build/release/semantic-release.config.cjs",
    "release:dry": "semantic-release --dry-run --extends ./build/release/semantic-release.local.config.cjs",
    "release:dry:ci": "semantic-release --dry-run --extends ./build/release/semantic-release.config.cjs",
    "release:gitlab": "semantic-release --extends ./build/release/semantic-release.gitlab.config.cjs",
    "release:dry:gitlab": "semantic-release --dry-run --extends ./build/release/semantic-release.local.config.cjs",
    "release:github": "semantic-release --extends ./build/release/semantic-release.config.cjs",
    "ci:validate": "npm run typecheck && npm run lint && npm run test:run && npm run build"
  },
  "dependencies": {
    "axios": "^1.17.0",
    "pinia": "^3.0.4",
    "sass": "^1.100.0",
    "vue": "^3.5.32",
    "vue-i18n": "^11.4.5",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@playwright/test": "^1.60.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/gitlab": "^13.3.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/eslint-plugin": "^1.6.16",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-vue": "~10.8.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.60.0",
    "prettier": "3.8.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "semantic-release": "^25.0.3",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix"
    ],
    "*.{scss,css,json,md}": [
      "prettier --write"
    ]
  }
}
